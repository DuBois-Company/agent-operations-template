{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python tools/validate.py --quick" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          { "type": "command", "command": "python tools/check_grounding.py" }
        ]
      }
    ]
  }
}
